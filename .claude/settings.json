{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [".claude/hooks/design-guard.mjs"],
            "timeout": 10,
            "statusMessage": "Checking design rules"
          }
        ]
      }
    ]
  }
}
